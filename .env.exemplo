# Copie para .env (ou exporte no terminal) e ajuste.

# Banco (docker compose up -d sobe um Postgres + PostGIS com estes dados)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/volante

# API
PORTA=3000
JWT_SEGREDO=troque-por-um-segredo-longo-e-aleatorio
# simulado = Pix de mentira para testes | nao_configurado | asaas
PAGAMENTO_GATEWAY=simulado
ARMAZENAMENTO_DIR=.armazenamento

# Worker
ASAAS_API_KEY=
ASAAS_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
PUSH_PROVEDOR=nenhum

# Admin criado pelo "pnpm db:semear"
ADMIN_EMAIL=admin@volante.dev
ADMIN_SENHA=admin12345

# App mobile: endereço da API visto pelo celular (opcional; por padrão usa o IP do computador)
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
