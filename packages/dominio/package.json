{
  "name": "@volante/dominio",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@volante/contracts": "workspace:*",
    "@volante/db": "workspace:*",
    "luxon": "^3.7.0",
    "uuidv7": "^1.0.2"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.0",
    "tsup": "^8.5.0",
    "vitest": "^3.2.4"
  }
}
